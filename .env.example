# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# OpenAI API key — powers the BUILT-IN tutor chat and course-name derivation.
# The MCP server does not need it: the host (ChatGPT, Claude) is the model there.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Optional — every one of these has a working default
# ---------------------------------------------------------------------------

# Chat model. Defaults to gpt-4o-mini, which is what the prompts are tuned for.
# OPENAI_MODEL=gpt-4o-mini

# Where the SQLite file lives. Defaults to ./data/app.db, which is gitignored.
# The directory is created on first run.
# DATABASE_PATH=./data/app.db

# --- yt-dlp -----------------------------------------------------------------
# Transcripts come from the yt-dlp binary on this machine. It must be on your
# PATH; see the README for install instructions. Nothing below is required.

# An explicit path, if yt-dlp is not on PATH.
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Subtitle languages, in yt-dlp's own syntax and in order of preference.
# `en.*` before bare `en` so regional variants and YouTube's `en-orig` track
# are reachable. Set this to ingest courses in another language.
# YTDLP_SUB_LANGS=en.*,en

# How long one video may take before it is written down as failed.
# YTDLP_TIMEOUT_MS=120000

# Reuse a signed-in browser session. Set this if YouTube starts answering with
# "Sign in to confirm you're not a bot" — common on a VPS, and for age-gated
# videos. Takes a browser name: chrome, firefox, edge, brave, safari…
# YTDLP_COOKIES_FROM_BROWSER=firefox

# --- Hosted transcript fallback (optional) ----------------------------------
# When set, Supadata (https://supadata.ai) is tried for any video yt-dlp could
# not fetch. Leave it blank and the app uses yt-dlp alone, which is the default
# and needs no account.
# SUPADATA_API_KEY=

# --- Chat persistence (optional) --------------------------------------------
# Sign up at https://cloud.assistant-ui.com to keep chat threads across reloads.
# NEXT_PUBLIC_ASSISTANT_BASE_URL=
